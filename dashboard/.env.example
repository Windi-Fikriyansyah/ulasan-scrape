# Dipakai aplikasi saat berjalan (role biasa, BUKAN superuser)
DATABASE_URL=postgres://ulasan_app:GANTI_PASSWORD_APP@localhost:5432/ulasan_tokped
# Hanya untuk db:create, db:migrate, dan skrip admin (superuser atau pemilik database)
DATABASE_ADMIN_URL=postgres://postgres:GANTI_PASSWORD_ADMIN@localhost:5432/ulasan_tokped
DATABASE_SSL=false
ALLOW_REGISTRATION=true
# true hanya bila di belakang reverse proxy tepercaya (untuk membaca x-forwarded-for)
TRUST_PROXY=false
# Hanya untuk pengembangan darurat: izinkan aplikasi jalan sebagai superuser (RLS tidak berlaku)
ALLOW_SUPERUSER_DB=false
