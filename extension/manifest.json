{
  "manifest_version": 3,
  "name": "Ulasan Tokped Bridge",
  "version": "2.0.0",
  "description": "Pasang sekali. Semua kendali pengambilan ulasan Tokopedia ada di dashboard web.",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://www.tokopedia.com/*",
    "https://shopee.co.id/*",
    "https://www.google.com/maps/*",
    "https://www.facebook.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Buka dashboard Ulasan Tokped"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.tokopedia.com/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.tokopedia.com/*"
      ],
      "js": [
        "scraper.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://shopee.co.id/*"
      ],
      "js": [
        "shopee-scraper.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.google.com/maps/*"
      ],
      "js": [
        "maps-scraper.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.facebook.com/*"
      ],
      "js": [
        "fb-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.facebook.com/*"
      ],
      "js": [
        "fb-groups.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://www.facebook.com/*"
      ],
      "js": [
        "fb-poster.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*",
        "http://localhost:3001/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}